#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

STATE_DIR="${STATE_DIR:-$SCRIPT_DIR/state/futures_um_1s_firstday_prefix_repair}"
STATE_FILE="$STATE_DIR/progress.json"
SYMBOL_PROGRESS_FILE="$STATE_DIR/symbol_progress.json"
LOG_FILE="${LOG_FILE:-$SCRIPT_DIR/logs/futures_um_1s_firstday_prefix_repair.log}"
SCREEN_NAME="${SCREEN_NAME:-futures_um_1s_firstday_prefix_repair}"
TOTAL_SYMBOLS="${TOTAL_SYMBOLS:-12}"

INTERVAL=30
ONCE=false

usage() {
  cat <<'EOF'
Usage:
  ./watch-futures-um-1s-firstday-prefix-repair
  ./watch-futures-um-1s-firstday-prefix-repair 10
  ./watch-futures-um-1s-firstday-prefix-repair --once
EOF
}

if [[ $# -gt 1 ]]; then
  usage
  exit 1
fi

if [[ $# -eq 1 ]]; then
  case "$1" in
    --once)
      ONCE=true
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      if [[ "$1" =~ ^[0-9]+$ ]] && [[ "$1" -gt 0 ]]; then
        INTERVAL="$1"
      else
        echo "Invalid argument: $1"
        usage
        exit 1
      fi
      ;;
  esac
fi

run_screen_ls() {
  screen -ls
}

run_query() {
  local query="$1"
  curl -sS 'http://localhost:8123/?password=123456' --data-binary "$query"
}

print_runner_status() {
  local screen_output
  screen_output="$(run_screen_ls 2>/dev/null || true)"

  if [[ "$screen_output" == *"$SCREEN_NAME"* ]]; then
    echo "Runner: RUNNING (screen: $SCREEN_NAME)"
  else
    echo "Runner: NOT RUNNING (screen: $SCREEN_NAME)"
  fi
}

print_db_summary() {
  local query result
  query="SELECT uniqExact(symbol), count(), min(open_time), max(open_time) FROM data4BT_futures_um_1s.klines_1s WHERE symbol IN ('AAVEUSDT','ASTERUSDT','DOGEUSDT','DOTUSDT','ETHUSDT','LINKUSDT','LTCUSDT','PAXGUSDT','SOLUSDT','WLFIUSDT','XLMUSDT','ZECUSDT') AND open_time >= toDateTime64('2025-12-11 00:00:00', 3, 'UTC') AND open_time < toDateTime64('2025-12-12 00:00:00', 3, 'UTC') FORMAT TSV"

  if ! result="$(run_query "$query" 2>/dev/null)"; then
    echo "DB summary: N/A"
    return
  fi

  local symbols rows min_open max_open
  IFS=$'\t' read -r symbols rows min_open max_open <<<"$result"
  echo "DB symbols: ${symbols:-N/A}"
  echo "DB rows: ${rows:-N/A}"
  echo "DB time range: ${min_open:-N/A} -> ${max_open:-N/A}"
}

print_state_summary() {
  python3 - "$STATE_FILE" "$SYMBOL_PROGRESS_FILE" "$TOTAL_SYMBOLS" <<'PY'
import json
import sys
from pathlib import Path

state_file = Path(sys.argv[1])
symbol_progress_file = Path(sys.argv[2])
total_symbols = sys.argv[3]

tracked = 0
if state_file.exists():
    tracked = len(json.loads(state_file.read_text()))

if not symbol_progress_file.exists():
    print(f"State tracked: {tracked}/{total_symbols}")
    print(f"State completed: 0/{total_symbols}")
    print("State running: 0")
    print("State failed: 0")
    print("Latest state update: N/A")
    sys.exit(0)

data = json.loads(symbol_progress_file.read_text())
completed = sum(1 for item in data.values() if item.get("status") == "completed")
running = sum(1 for item in data.values() if item.get("status") == "running")
failed = sum(1 for item in data.values() if item.get("status") == "failed")
latest_update = max((item.get("last_update", "") for item in data.values()), default="")

if tracked == 0:
    tracked = len(data)

print(f"State tracked: {tracked}/{total_symbols}")
print(f"State completed: {completed}/{total_symbols}")
print(f"State running: {running}")
print(f"State failed: {failed}")
print(f"Latest state update: {latest_update or 'N/A'}")
PY
}

print_recent_logs() {
  echo ""
  echo "Recent log lines:"
  if [[ -f "$LOG_FILE" ]]; then
    tail -n 5 "$LOG_FILE"
  else
    echo "Log file missing: $LOG_FILE"
  fi
}

print_screen() {
  if [[ -t 1 ]]; then
    clear 2>/dev/null || true
  fi

  echo "=== Data4BT Futures-UM 1s First-Day Prefix Repair  $(date '+%F %T') ==="
  print_runner_status
  print_db_summary
  echo
  print_state_summary
  print_recent_logs

  if [[ "$ONCE" == "false" ]]; then
    echo
    echo "Refresh every ${INTERVAL}s. Ctrl+C to exit."
  fi
}

while true; do
  print_screen
  if [[ "$ONCE" == "true" ]]; then
    exit 0
  fi
  sleep "$INTERVAL"
done
