#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PID_FILE="$SCRIPT_DIR/.one_year_download_pid"
STATE_FILE="$SCRIPT_DIR/state/one_year/progress.json"
PROC_PATTERN='go run cmd/main.go -cmd=update-latest -config=configs/config-one-year.yml|/go-build.*/exe/main -cmd=update-latest -config=configs/config-one-year.yml'

INTERVAL=30
ONCE=false

usage() {
  cat <<'EOF'
Usage:
  ./watch              # refresh every 30s
  ./watch 10           # refresh every 10s
  ./watch --once       # print once and exit
EOF
}

if [[ $# -gt 1 ]]; then
  usage
  exit 1
fi

if [[ $# -eq 1 ]]; then
  case "$1" in
    --once)
      ONCE=true
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      if [[ "$1" =~ ^[0-9]+$ ]] && [[ "$1" -gt 0 ]]; then
        INTERVAL="$1"
      else
        echo "Invalid argument: $1"
        usage
        exit 1
      fi
      ;;
  esac
fi

print_screen() {
  if [[ -t 1 ]]; then
    clear 2>/dev/null || true
  fi
  echo "=== Data4BT One-Year Monitor  $(date '+%F %T') ==="

  if [[ -f "$PID_FILE" ]]; then
    local pid
    pid="$(cat "$PID_FILE" 2>/dev/null || true)"
    if [[ -n "$pid" ]] && ps -p "$pid" >/dev/null 2>&1; then
      echo "Process: RUNNING"
      ps -p "$pid" -o pid=,ppid=,etime=,%cpu=,%mem=,command=
    else
      local found_pid
      found_pid="$(
        ps -axo pid,command \
          | grep -E "$PROC_PATTERN" \
          | grep -v grep \
          | awk 'NR==1{print $1}' \
          || true
      )"
      if [[ -n "${found_pid:-}" ]] && ps -p "$found_pid" >/dev/null 2>&1; then
        echo "$found_pid" > "$PID_FILE"
        echo "Process: RUNNING (pid file refreshed)"
        ps -p "$found_pid" -o pid=,ppid=,etime=,%cpu=,%mem=,command=
      else
        echo "Process: NOT RUNNING (pid file exists, pid=${pid:-unknown})"
      fi
    fi
  else
    local found_pid
    found_pid="$(
      ps -axo pid,command \
        | grep -E "$PROC_PATTERN" \
        | grep -v grep \
        | awk 'NR==1{print $1}' \
        || true
    )"
    if [[ -n "${found_pid:-}" ]] && ps -p "$found_pid" >/dev/null 2>&1; then
      echo "$found_pid" > "$PID_FILE"
      echo "Process: RUNNING (pid file created)"
      ps -p "$found_pid" -o pid=,ppid=,etime=,%cpu=,%mem=,command=
    else
      echo "Process: PID file missing ($PID_FILE)"
    fi
  fi

  local rows
  rows="$(curl -sS -u default:123456 -X POST 'http://localhost:8123/' --data 'SELECT count() FROM data4BT.klines_1m' 2>/dev/null || echo 'N/A')"
  echo "Rows(data4BT.klines_1m): $rows"
  echo

  if [[ -f "$STATE_FILE" ]]; then
    jq -r '
      to_entries as $e |
      "Symbols: \($e|length)",
      "Processed symbols: \($e|map(select((.value.processed // 0) > 0))|length)",
      "Total processed months: \($e|map(.value.processed // 0)|add // 0)",
      "Latest state update: \($e|map(.value.last_updated // "")|max)",
      "",
      "Top progress:",
      (
        $e
        | map({
            symbol: .key,
            processed: (.value.processed // 0),
            last_date: (.value.last_date // "")
          })
        | sort_by(.processed) | reverse | .[0:10]
        | .[]
        | "  \(.symbol)\tprocessed=\(.processed)\tlast_date=\(.last_date)"
      )
    ' "$STATE_FILE"
  else
    echo "State file missing: $STATE_FILE"
  fi

  if [[ "$ONCE" == "false" ]]; then
    echo
    echo "Refresh every ${INTERVAL}s. Ctrl+C to exit."
  fi
}

while true; do
  print_screen
  if [[ "$ONCE" == "true" ]]; then
    exit 0
  fi
  sleep "$INTERVAL"
done
