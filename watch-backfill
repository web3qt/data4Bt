#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PID_FILE="$SCRIPT_DIR/.backfill_2024_2025_pid"
STATE_FILE="$SCRIPT_DIR/state/backfill_2024_2025/progress.json"
TIMELINE_FILE="$SCRIPT_DIR/state/backfill_2024_2025/timelines.json"
PROC_PATTERN='go run cmd/main.go -cmd=update-latest -config=configs/config-backfill-2024-2025.yml|/go-build.*/exe/main -cmd=update-latest -config=configs/config-backfill-2024-2025.yml|go run cmd/main.go -cmd=run -config=configs/config-backfill-2024-2025.yml|/go-build.*/exe/main -cmd=run -config=configs/config-backfill-2024-2025.yml'

INTERVAL=30
ONCE=false

usage() {
  cat <<'EOF'
Usage:
  ./watch-backfill              # refresh every 30s
  ./watch-backfill 10           # refresh every 10s
  ./watch-backfill --once       # print once and exit
EOF
}

if [[ $# -gt 1 ]]; then
  usage
  exit 1
fi

if [[ $# -eq 1 ]]; then
  case "$1" in
    --once)
      ONCE=true
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      if [[ "$1" =~ ^[0-9]+$ ]] && [[ "$1" -gt 0 ]]; then
        INTERVAL="$1"
      else
        echo "Invalid argument: $1"
        usage
        exit 1
      fi
      ;;
  esac
fi

print_screen() {
  if [[ -t 1 ]]; then
    clear 2>/dev/null || true
  fi

  echo "=== Data4BT Backfill 2024-03~2025-02  $(date '+%F %T') ==="

  local found_pid
  found_pid="$(
    ps -axo pid,command \
      | grep -E "$PROC_PATTERN" \
      | grep -v grep \
      | awk 'NR==1{print $1}' \
      || true
  )"

  if [[ -n "${found_pid:-}" ]] && ps -p "$found_pid" >/dev/null 2>&1; then
    echo "$found_pid" > "$PID_FILE"
    echo "Process: RUNNING"
    ps -p "$found_pid" -o pid=,ppid=,etime=,%cpu=,%mem=,command=
  else
    if [[ -f "$PID_FILE" ]]; then
      echo "Process: NOT RUNNING (last pid=$(cat "$PID_FILE" 2>/dev/null || echo unknown))"
    else
      echo "Process: NOT RUNNING"
    fi
  fi

  local rows_window rows_total
  rows_window="$(
    curl -sS -u default:123456 -X POST 'http://localhost:8123/' \
      --data "SELECT count() FROM data4BT.klines_1m WHERE open_time >= toDateTime64('2024-03-01 00:00:00', 3) AND open_time < toDateTime64('2025-03-01 00:00:00', 3)" \
      2>/dev/null || echo 'N/A'
  )"
  rows_total="$(
    curl -sS -u default:123456 -X POST 'http://localhost:8123/' \
      --data "SELECT count() FROM data4BT.klines_1m" \
      2>/dev/null || echo 'N/A'
  )"
  echo "Rows(window 2024-03~2025-02): $rows_window"
  echo "Rows(total klines_1m): $rows_total"
  echo

  if [[ -f "$STATE_FILE" ]]; then
    jq -r '
      to_entries as $e |
      "Symbols: \($e|length)",
      "Processed symbols: \($e|map(select((.value.processed // 0) > 0))|length)",
      "Total processed months: \($e|map(.value.processed // 0)|add // 0)",
      "Latest state update: \($e|map(.value.last_updated // "")|max)",
      "",
      "Top progress:",
      (
        $e
        | map({symbol: .key, processed: (.value.processed // 0), last_date: (.value.last_date // "")})
        | sort_by(.processed) | reverse | .[0:10]
        | .[]
        | "  \(.symbol)\tprocessed=\(.processed)\tlast_date=\(.last_date)"
      )
    ' "$STATE_FILE"
  else
    echo "State file missing: $STATE_FILE"
  fi

  if [[ -f "$TIMELINE_FILE" ]]; then
    local timeline_count
    timeline_count="$(jq 'length' "$TIMELINE_FILE" 2>/dev/null || echo 0)"
    echo
    echo "Timeline cache loaded: $timeline_count"
  fi

  if [[ "$ONCE" == "false" ]]; then
    echo
    echo "Refresh every ${INTERVAL}s. Ctrl+C to exit."
  fi
}

while true; do
  print_screen
  if [[ "$ONCE" == "true" ]]; then
    exit 0
  fi
  sleep "$INTERVAL"
done
